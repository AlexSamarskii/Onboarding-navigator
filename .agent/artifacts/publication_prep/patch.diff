+def _resolve_hash_target(entry):
+    """Resolve the recorded direct path, then its installed dependency module."""
+    direct = ROOT / entry["path"]
+    if direct.is_file():
+        return direct
+    if entry.get("location") == "dependency" and "module" in entry:
+        try:
+            spec = importlib.util.find_spec(entry["module"])
+        except ModuleNotFoundError:
+            spec = None
+        if spec and spec.origin:
+            candidate = Path(spec.origin)
+            if candidate.is_file():
+                return candidate
+    return None
+
