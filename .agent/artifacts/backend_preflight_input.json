{
  "stage": "G2/backend-preflight",
  "allowed_files": [
    "config/config.yaml",
    "config/i18n/ru.yaml",
    "workspace/telegram-rag-bot-src/telegram_rag_bot/i18n.py"
  ],
  "change_plan": ".agent/artifacts/backend_preflight_change_plan.yaml",
  "acceptance_criteria": ".agent/artifacts/acceptance_criteria.yaml",
  "architecture": ".agent/artifacts/architecture_plan.md",
  "reuse_map": ".agent/artifacts/reuse_map.yaml",
  "config": {
    "modes": {
      "directory": "modes"
    },
    "rag": {
      "score_threshold": 0.65
    },
    "integrations": {
      "ticketing": {
        "url": "${TICKETING_WEBHOOK_URL}",
        "hr_chat_id": "${HR_CHAT_ID}"
      }
    },
    "i18n": {
      "default_locale": "ru"
    },
    "ADMIN_IDS": "${ADMIN_IDS}",
    "session": {
      "ttl_seconds": 86400
    },
    "retrieval": {
      "async_mode": false
    },
    "llm": {
      "providers": [
        "gigachat",
        "yandexgpt"
      ]
    }
  },
  "locale_required": {
    "citation.unavailable": "основание недоступно",
    "plan.not_configured": "план для вашей роли пока не настроен",
    "ticket.failed": "не удалось создать заявку, попробуйте позже",
    "fallback.suggestions_header": "возможно, вы имели в виду:",
    "admin.denied": "недостаточно прав"
  },
  "locale_sections": [
    "diagnostics.vpn",
    "diagnostics.mail",
    "commands.help",
    "commands.start",
    "commands.reindex",
    "commands.status"
  ],
  "locale_scope": "Full RU UI catalog for 35 AC; interpolation {placeholder}; no EN",
  "api": [
    "load_locale(path) -> dict",
    "t(key, **kwargs) -> str",
    "Nested dotted keys; no handlers/Telegram imports"
  ],
  "artifacts": [
    ".agent/artifacts/patch.diff",
    ".agent/artifacts/implementation_note.md",
    ".agent/artifacts/review.json"
  ],
  "review_fix_limit": 3,
  "prohibited": "Any product changes outside allowed_files, data-zone changes, secret file reads, real tokens, live provider/Telegram calls, committing"
}
