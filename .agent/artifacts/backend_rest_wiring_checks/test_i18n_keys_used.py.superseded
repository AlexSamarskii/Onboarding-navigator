# SUPERSEDED: wiring literal-retention assertion conflicts with approved i18n migration.
# Replacement: .agent/artifacts/backend_rest_i18n_checks/test_legacy_and_ui_cyrillic.py
# Original SHA256: 81b87f6526a3c86d3dd0fa4946b454c835fc11949165c90730586cbcf6f68e63
"""New literal locale keys must exist; legacy UI migration is intentionally deferred."""
import ast
from collections import Counter
import json
from pathlib import Path
import tomllib
import yaml

ROOT = Path(__file__).resolve().parents[3]
SRC = ROOT / 'workspace/telegram-rag-bot-src'


def test_literal_locale_calls_resolve():
    catalog = yaml.safe_load((ROOT / 'config/i18n/ru.yaml').read_text())
    used = []
    for filename in ('main.py', 'handlers.py'):
        tree = ast.parse((SRC / 'telegram_rag_bot' / filename).read_text())
        for node in ast.walk(tree):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 't' and node.args and isinstance(node.args[0], ast.Constant):
                key = node.args[0].value
                value = catalog
                for part in key.split('.'):
                    assert part in value, f'{filename}:{node.lineno}: {key}'
                    value = value[part]
                assert isinstance(value, str)
                used.append(key)
    assert {'citation.reference', 'fallback.no_answer', 'ticket.created', 'status.summary', 'profile.ask_role'} <= set(used)


def test_existing_cyrillic_literals_retained_without_migration():
    snapshot = json.loads((ROOT / '.agent/artifacts/backend_rest_wiring_snapshot.json').read_text())
    path = 'workspace/telegram-rag-bot-src/telegram_rag_bot/handlers.py'
    before = snapshot['before'][path]
    def literals(source):
        return Counter(node.value for node in ast.walk(ast.parse(source)) if isinstance(node, ast.Constant) and isinstance(node.value, str) and any('\u0400' <= char <= '\u04ff' for char in node.value))
    assert literals(before) == literals((ROOT / path).read_text())


def test_project_metadata_unchanged_and_testpaths_exist():
    snapshot = json.loads((ROOT / '.agent/artifacts/backend_rest_wiring_snapshot.json').read_text())
    before = tomllib.loads(snapshot['before']['workspace/telegram-rag-bot-src/pyproject.toml'])
    after = tomllib.loads((SRC / 'pyproject.toml').read_text())
    assert before['project'] == after['project']
    assert before['build-system'] == after['build-system']
    for value in after['tool']['pytest']['ini_options']['testpaths']:
        assert (SRC / value).is_dir()
    assert after['tool']['pytest']['ini_options']['asyncio_mode'] == 'auto'
    assert after['tool']['coverage']['run']['source'] == ['telegram_rag_bot']
