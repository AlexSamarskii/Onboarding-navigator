+@contextmanager
+def generation_scope():
+    """One model request only; never let failed attempts leak to another request."""
+    token = _generation_state.set({"failed_gigachat": False, "switched": False})
+    try:
+        yield
+    finally:
+        _generation_state.reset(token)
+
