+
+def legacy_ui(key, **kwargs):
+    """Use a loaded locale when available; preserve standalone legacy commands."""
+    from telegram_rag_bot.i18n import t
+    try:
+        return t(key, **kwargs)
+    except (RuntimeError, KeyError):
+        return _LEGACY_UI[key].format(**kwargs)
